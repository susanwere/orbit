# Orbit API
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://orbit:orbit@localhost:5433/orbit
ORBIT_ORGANIZATION_ID=org_orbit_demo

# GitHub webhook ingress
# Configure a strong secret in GitHub and use the same value here.
GITHUB_WEBHOOK_SECRET=

# Web (Vite)
VITE_API_BASE_URL=http://localhost:4000
# Google OAuth Web application client ID; public identifier, never a secret.
VITE_GOOGLE_CLIENT_ID=

# Meta Model API
MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_DECISION_MODEL=muse-spark-1.3

# OIDC token exchange (pre-provision linked identities in principal_oidc_identities)
# Set these only after registering a trusted OIDC application.
ORBIT_AUTH_SECRET=
ORBIT_AUTH_ISSUER=
ORBIT_OIDC_ISSUER=
ORBIT_OIDC_AUDIENCE=
ORBIT_OIDC_JWKS_URL=
# Exact frontend origins allowed credentialed API access (no trailing slash).
ORBIT_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set NODE_ENV=production in HTTPS deployments to require Secure refresh cookies.

# Local CI observer only: fine-grained PAT, private-test only, Actions/Pull requests/Contents read.
# Configure privately in apps/api/.env.local; never pass to Muse.
ORBIT_GITHUB_EVIDENCE_TOKEN=

# Email verification and password reset (Resend sender must use a verified domain)
# Keep the API key private. ORBIT_APP_URL is where browser verification links open.
ORBIT_RESEND_API_KEY=
ORBIT_EMAIL_FROM=
ORBIT_APP_URL=https://your-orbit-domain.example
