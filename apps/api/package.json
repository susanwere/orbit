{
  "name": "@orbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "muse:demo": "node --env-file-if-exists=../../.env.local --import tsx src/muse-local-demo.ts",
    "muse:open-jobs": "node --env-file-if-exists=../../.env.local --import tsx src/muse-open-jobs-demo.ts"
  },
  "dependencies": {
    "@orbit/domain": "*",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "@orbit/db": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
